# Copy to .env and fill in (never commit .env)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OPENAI_API_KEY=sk-...

# Optional
ADMIN_USER_ID=0
BOT_DATA_DIR=./bot_data

# External tools (must be on PATH or set absolute paths)
NUCLEI_BIN=nuclei
NUCLEI_TEMPLATES=

# Gobuster wordlist (Linux example: /usr/share/seclists/Discovery/Web-Content/common.txt)
GOBUSTER_WORDLIST=

# XSStrike: path to xsstrike.py relative to cwd when bot starts, or absolute
XSSTRIKE_SCRIPT=XSStrike/xsstrike.py
